# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebooks checkpoints
.ipynb_checkpoints

# Datasets (Do not commit large raw/processed images to git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
dataset/

# Large model checkpoint weights
checkpoints/*.pth
checkpoints/*.pt
!checkpoints/.gitkeep

# Results output (Keep directories tracked via .gitkeep)
results/logs/*
!results/logs/.gitkeep
results/plots/*
!results/plots/.gitkeep
results/confusion_matrices/*
!results/confusion_matrices/.gitkeep

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store
